 900:./segger-rtt/src/SEGGER_RTT.c **** /*********************************************************************
 901:./segger-rtt/src/SEGGER_RTT.c **** *
 902:./segger-rtt/src/SEGGER_RTT.c **** *       SEGGER_RTT_WriteSkipNoLock
 903:./segger-rtt/src/SEGGER_RTT.c **** *
 904:./segger-rtt/src/SEGGER_RTT.c **** *  Function description
 905:./segger-rtt/src/SEGGER_RTT.c **** *    Stores a specified number of characters in SEGGER RTT
 906:./segger-rtt/src/SEGGER_RTT.c **** *    control block which is then read by the host.
 907:./segger-rtt/src/SEGGER_RTT.c **** *    SEGGER_RTT_WriteSkipNoLock does not lock the application and
 908:./segger-rtt/src/SEGGER_RTT.c **** *    skips all data, if the data does not fit into the buffer.
ARM GAS  C:\Users\PRAETE~1\AppData\Local\Temp\ccgoOOhI.s 			page 41


 909:./segger-rtt/src/SEGGER_RTT.c **** *
 910:./segger-rtt/src/SEGGER_RTT.c **** *  Parameters
 911:./segger-rtt/src/SEGGER_RTT.c **** *    BufferIndex  Index of "Up"-buffer to be used (e.g. 0 for "Terminal").
 912:./segger-rtt/src/SEGGER_RTT.c **** *    pBuffer      Pointer to character array. Does not need to point to a \0 terminated string.
 913:./segger-rtt/src/SEGGER_RTT.c **** *    NumBytes     Number of bytes to be stored in the SEGGER RTT control block.
 914:./segger-rtt/src/SEGGER_RTT.c **** *                 MUST be > 0!!!
 915:./segger-rtt/src/SEGGER_RTT.c **** *                 This is done for performance reasons, so no initial check has do be done.
 916:./segger-rtt/src/SEGGER_RTT.c **** *
 917:./segger-rtt/src/SEGGER_RTT.c **** *  Return value
 918:./segger-rtt/src/SEGGER_RTT.c **** *    1: Data has been copied
 919:./segger-rtt/src/SEGGER_RTT.c **** *    0: No space, data has not been copied
 920:./segger-rtt/src/SEGGER_RTT.c **** *
 921:./segger-rtt/src/SEGGER_RTT.c **** *  Notes
 922:./segger-rtt/src/SEGGER_RTT.c **** *    (1) If there is not enough space in the "Up"-buffer, all data is dropped.
 923:./segger-rtt/src/SEGGER_RTT.c **** *    (2) For performance reasons this function does not call Init()
 924:./segger-rtt/src/SEGGER_RTT.c **** *        and may only be called after RTT has been initialized.
 925:./segger-rtt/src/SEGGER_RTT.c **** *        Either by calling SEGGER_RTT_Init() or calling another RTT API function first.
 926:./segger-rtt/src/SEGGER_RTT.c **** */
 927:./segger-rtt/src/SEGGER_RTT.c **** #if (RTT_USE_ASM == 0)
 928:./segger-rtt/src/SEGGER_RTT.c **** unsigned SEGGER_RTT_WriteSkipNoLock(unsigned BufferIndex, const void* pBuffer, unsigned NumBytes) {
 929:./segger-rtt/src/SEGGER_RTT.c ****   const char*           pData;
 930:./segger-rtt/src/SEGGER_RTT.c ****   SEGGER_RTT_BUFFER_UP* pRing;
 931:./segger-rtt/src/SEGGER_RTT.c ****   unsigned              Avail;
 932:./segger-rtt/src/SEGGER_RTT.c ****   unsigned              RdOff;
